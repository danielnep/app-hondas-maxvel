      },
      "steps": [
        {
          "action": "expect_visible",
          "target": {
            "role": "link",
            "name": "Aplicativo"
          }
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Aplicativo"
          }
        },
        {
          "action": "expect_visible",
          "target": {
            "role": "button",
            "name": "Abrir perfil e opções"
          }
        }
      ]
    }
  ]
}
